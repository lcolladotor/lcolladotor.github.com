    <item>
      <title>Dissecting transcriptomic signatures of neuronal differentiation and maturation using iPSCs</title>
      <link>https://lcolladotor.github.io/publication/2020-01_libdstemcell/</link>
      <pubDate>Thu, 23 Jan 2020 00:00:00 +0000</pubDate>
      <guid>https://lcolladotor.github.io/publication/2020-01_libdstemcell/</guid>
